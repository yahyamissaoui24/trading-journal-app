# PostgreSQL connection strings (Supabase).
# DATABASE_URL = "Transaction pooler" connection (port 6543, ?pgbouncer=true) — used at runtime
# DIRECT_URL   = "Session pooler" connection (port 5432, same pooler host) — used for migrations
#                (the "Direct connection" / db.xxxx.supabase.co host is IPv6-only on the free tier
#                 and will fail to connect from most home networks — use Session pooler instead)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# NextAuth
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Public app URL, used for payment/OAuth redirect URLs
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — omit both to disable "Sign in with Google")
# Create at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Apple Sign In (optional — omit both to disable "Sign in with Apple")
# Requires an Apple Developer account. APPLE_CLIENT_SECRET is a JWT you generate
# yourself (signed with a private key from your Apple Developer account) — see README.
APPLE_CLIENT_ID=""
APPLE_CLIENT_SECRET=""

# NOWPayments (crypto payments for Premium)
# Get your API key from https://nowpayments.io dashboard → Store Settings
NOWPAYMENTS_API_KEY=""
# IPN secret, from the same dashboard — used to verify webhook authenticity
NOWPAYMENTS_IPN_SECRET=""
